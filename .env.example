# ==============================================================================
# Ariatrading runtime configuration
# ==============================================================================
# paper = research/paper account
# demo  = real MT5 market data + broker DEMO execution
# live  = real broker execution, guarded by the Stage-1 deployment policy

BOT_MODE=paper
DEFAULT_SYMBOLS=EURUSD
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.0025
BOT_POLL_SECONDS=5

# MT5 terminal/account selection. Keep the password out of Git.
# MetaTrader5 can initialize/login to this exact account instead of silently
# using the terminal's last-used account.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=8808

# Runtime execution safeguards. These are deliberately conservative defaults.
MT5_MAX_TICK_AGE_SECONDS=5
MT5_MAX_SPREAD_POINTS=20
MT5_MAX_DAILY_DRAWDOWN=0.01
BOT_CONTROL_PATH=data/bot_control.json

# Explicit application-level LIVE switch. Keep 0 unless Stage-1 deployment
# policy is also armed below.
ALLOW_LIVE=0

# ==============================================================================
# LIVE Stage-1 deployment gate
# ==============================================================================
# These values must match the exact broker account you intend to trade.
# Stage 1 permits exactly one symbol and enforces hard risk/operational limits.
ARIATRADING_ENABLE_LIVE=
ARIATRADING_LIVE_STAGE=0
ARIATRADING_LIVE_ACCOUNT=
ARIATRADING_LIVE_SERVER=
ARIATRADING_LIVE_SYMBOLS=EURUSD
ARIATRADING_LIVE_MAX_RISK=0.0025
ARIATRADING_LIVE_MAX_DAILY_DD=0.01
ARIATRADING_LIVE_MAX_SPREAD_POINTS=20
ARIATRADING_LIVE_MAX_TICK_AGE_SECONDS=5

# Durable/local runtime state
SQLITE_PATH=data/ariatrading.db
REDIS_URL=

# Operational REST/WebSocket API
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
HEALTH_ALLOWED_IPS=
MAX_REQUEST_RATE=5
MAX_REQUEST_BURST=10
RUNTIME_API_TOKEN=
MT5_RUNTIME_API_URL=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1
WEBHOOK_ALERT_URL=
