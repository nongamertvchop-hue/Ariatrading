# ==============================================================================
# Ariatrading runtime configuration (PAPER/DEMO only)
# ==============================================================================

BOT_MODE=paper
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.01
BOT_POLL_SECONDS=2

# MT5 terminal/account for read-only/demo market access only. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=8808

# Real-money broker execution is intentionally disabled by the supported runtime.
ALLOW_LIVE=0

# Durable/local runtime state
SQLITE_PATH=data/ariatrading.db
REDIS_URL=

# Operational REST/WebSocket API
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
HEALTH_ALLOWED_IPS=
MAX_REQUEST_RATE=5
MAX_REQUEST_BURST=10
RUNTIME_API_TOKEN=
MT5_RUNTIME_API_URL=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1
WEBHOOK_ALERT_URL=
