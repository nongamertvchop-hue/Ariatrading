# ==============================================================================
# Ariatrading runtime configuration (DEMO/PAPER by default)
# ==============================================================================

BOT_MODE=paper
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.01
BOT_POLL_SECONDS=2

# MT5 terminal/account. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=8808

# ------------------------------------------------------------------------------
# LIVE Stage 1 — intentionally NOT armed in this example.
# The real deployment must provide these values through its secret/environment
# store. Stage 1 allows exactly one symbol and enforces a <=0.25% trade-risk cap,
# <=1% daily drawdown cap, <=20-point spread and <=5-second tick age.
# ------------------------------------------------------------------------------
ARIATRADING_ENABLE_LIVE=
ARIATRADING_LIVE_STAGE=0
ARIATRADING_LIVE_ACCOUNT=
ARIATRADING_LIVE_SERVER=
ARIATRADING_LIVE_SYMBOLS=EURUSD
ARIATRADING_LIVE_MAX_RISK=0.0025
ARIATRADING_LIVE_MAX_DAILY_DD=0.01
ARIATRADING_LIVE_MAX_SPREAD_POINTS=20
ARIATRADING_LIVE_MAX_TICK_AGE_SECONDS=5

# Legacy flag kept only for older paper/control tooling; it is NOT the LIVE gate.
ALLOW_LIVE=0

# Durable/local runtime state
SQLITE_PATH=data/ariatrading.db
REDIS_URL=

# Operational REST/WebSocket API
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# Comma-separated CIDRs/IPs. Empty means no IP filter; bind to localhost/VPN in production.
HEALTH_ALLOWED_IPS=
MAX_REQUEST_RATE=5
MAX_REQUEST_BURST=10
# Shared secret between Cloudflare Pages Functions and the runtime API.
# Keep this value identical in both deployments and never commit the real secret.
RUNTIME_API_TOKEN=

# Cloudflare Pages Function -> MT5 runtime bridge.
# Example: https://runtime.example.com (no trailing slash)
MT5_RUNTIME_API_URL=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1

# Optional generic webhook
WEBHOOK_ALERT_URL=
