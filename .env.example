# ==============================================================================
# Ariatrading runtime configuration (PAPER/DEMO by default)
# ==============================================================================

BOT_MODE=paper
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.01
BOT_POLL_SECONDS=2

# MT5 terminal/account. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=8808

# ------------------------------------------------------------------------------
# LIVE production stages — intentionally NOT armed in this example.
# The real execution host must supply the actual login/server through secrets.
# ------------------------------------------------------------------------------
ARIATRADING_ENABLE_LIVE=
ARIATRADING_LIVE_STAGE=0
ARIATRADING_LIVE_ACCOUNT=
ARIATRADING_LIVE_SERVER=
ARIATRADING_LIVE_SYMBOLS=EURUSD
ARIATRADING_LIVE_MAX_RISK=0.0025
ARIATRADING_LIVE_MAX_DAILY_DD=0.01
ARIATRADING_LIVE_MAX_SPREAD_POINTS=20
ARIATRADING_LIVE_MAX_TICK_AGE_SECONDS=5

# Stage 2 profile when ARIATRADING_LIVE_STAGE=2:
#   up to 2 explicitly allow-listed symbols
#   <=0.50% risk per trade
#   <=2% daily equity drawdown
#   <=30-point spread
#   <=10-second tick age
# Code-level hard caps prevent environment values from raising these limits.

# Legacy control flag; it is not the production LIVE gate.
ALLOW_LIVE=0

# Durable/local runtime state
SQLITE_PATH=data/ariatrading.db
REDIS_URL=

# Operational REST/WebSocket API
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
HEALTH_ALLOWED_IPS=
MAX_REQUEST_RATE=5
MAX_REQUEST_BURST=10
RUNTIME_API_TOKEN=
MT5_RUNTIME_API_URL=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1
WEBHOOK_ALERT_URL=
