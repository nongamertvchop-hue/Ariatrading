# ==============================================================================
# Ariatrading runtime configuration (DEMO/PAPER first)
# ==============================================================================

BOT_MODE=paper
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.01
BOT_POLL_SECONDS=2

# MT5 terminal/account. Never commit real credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC_NUMBER=8808
ALLOW_LIVE=0

# Durable/local runtime state
SQLITE_PATH=data/ariatrading.db
REDIS_URL=

# Operational REST/WebSocket API
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# Comma-separated CIDRs/IPs. Empty means no IP filter; bind to localhost/VPN in production.
HEALTH_ALLOWED_IPS=
MAX_REQUEST_RATE=5
MAX_REQUEST_BURST=10

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1

# Optional generic webhook
WEBHOOK_ALERT_URL=
