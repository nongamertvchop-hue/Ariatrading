# ==============================================================================
# Ariatrading Forex Configuration
# ==============================================================================

# Telegram Alerts (Optional but highly recommended)
# Get BOT Token from @BotFather, Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER_ENABLED=1

# Webhook Alert (Optional, e.g., Discord or custom backend)
WEBHOOK_ALERT_URL=

# MT5 Terminal Settings (Optional: specify custom path if not standard)
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MAGIC_NUMBER=8808

# Forex Execution Configuration
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_TIMEFRAME=15m
DEFAULT_RISK_PER_TRADE=0.01
DEFAULT_MODE=ALERT_ONLY
