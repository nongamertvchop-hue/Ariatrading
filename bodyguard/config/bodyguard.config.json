{
  "name": "Bodyguard(Aria)",
  "version": "0.02.0",
  "enabled": true,
  "mode": "enforce",
  "http": {
    "allowedMethods": ["GET", "HEAD", "OPTIONS"],
    "maxQueryLength": 512,
    "maxBodyBytes": 8192,
    "requireHttps": true
  },
  "api": {
    "publicRoutes": ["/api/signal", "/api/price", "/api/live-candle"],
    "symbolPattern": "^[A-Z]{3}/[A-Z]{3}$",
    "allowedTimeframes": ["1m", "5m", "15m", "30m", "1h", "4h", "1D"],
    "rateLimit": {
      "windowSeconds": 60,
      "maxRequestsPerIp": 60,
      "burst": 20
    },
    "softBan": {
      "blockThreshold": 8,
      "windowSeconds": 300,
      "banSeconds": 600
    }
  },
  "privacy": {
    "scrubHeaders": ["authorization", "cookie", "x-api-key"],
    "redactKeys": ["apikey", "api_key", "token", "secret", "password", "email", "phone"],
    "forbidClientSecretNames": ["TWELVE_DATA_API_KEY", "CLOUDFLARE_API_TOKEN", "BROKER_"]
  },
  "securityEvents": {
    "logToConsole": true,
    "levels": ["info", "warn", "block"]
  },
  "headers": {
    "x-bodyguard": "0.02.0",
    "x-content-type-options": "nosniff",
    "referrer-policy": "no-referrer",
    "x-frame-options": "DENY"
  }
}
